+++ b/hw/arm/prusa/parts/door_sensor.c
@@ -0,0 +1,140 @@
+/*
+	door_sensor.c - Sim door sensor for Mini404.
+
+	Written for Mini404 in 2026 in the style of hall_sensor.c by VintagePC.
+
+	This file is part of Mini404.
+	Mini404 is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 3 of the License, or
+	(at your option) any later version.
+	Mini404 is distributed in the hope that it will be useful,
+	but WITHOUT ANY WARRANTY; without even the implied warranty of
+	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+	GNU General Public License for more details.
+	You should have received a copy of the GNU General Public License
+	along with Mini404.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "qemu/osdep.h"
+#include "../utility/p404scriptable.h"
+#include "../utility/macros.h"
+#include "../utility/ScriptHost_C.h"
+#include "../utility/ArgHelper.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "qom/object.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+
+#define TYPE_DOOR_SENSOR "door-sensor"
+
+// Raw 12-bit levels the CORE One firmware reads on ADC3 channel 15. It sorts
+// them by midpoint: below 0x3ff closed, below 0xcff open, above that the
+// sensor counts as detached and the firmware refuses to run
+// (src/buddy/door_sensor.cpp).
+#define DOOR_RAW_CLOSED 0x000U
+#define DOOR_RAW_OPEN 0x7ffU
+#define DOOR_RAW_DETACHED 0xfffU
+
+OBJECT_DECLARE_SIMPLE_TYPE(DoorSensorState, DOOR_SENSOR)
+
+struct DoorSensorState {
+	SysBusDevice parent_obj;
+	/*< private >*/
+	/*< public >*/
+	uint32_t raw_value;
+	bool start_detached;
+	qemu_irq irq;
+};
+
+enum {
+	ACT_CLOSE,
+	ACT_OPEN,
+	ACT_DETACH,
+};
+
+OBJECT_DEFINE_TYPE_SIMPLE_WITH_INTERFACES(DoorSensorState, door_sensor, DOOR_SENSOR, SYS_BUS_DEVICE, {TYPE_P404_SCRIPTABLE}, {NULL})
+
+static void door_sensor_finalize(Object *obj)
+{
+}
+
+static void door_sensor_set(DoorSensorState *s, uint32_t raw)
+{
+	s->raw_value = raw;
+	qemu_set_irq(s->irq, s->raw_value);
+}
+
+static void door_sensor_reset(DeviceState *dev)
+{
+	DoorSensorState *s = DOOR_SENSOR(dev);
+	door_sensor_set(s, s->start_detached ? DOOR_RAW_DETACHED : DOOR_RAW_CLOSED);
+}
+
+static int door_sensor_process_action(P404ScriptIF *obj, unsigned int action, script_args args)
+{
+	DoorSensorState *s = DOOR_SENSOR(obj);
+	switch (action)
+	{
+		case ACT_CLOSE:
+			door_sensor_set(s, DOOR_RAW_CLOSED);
+			break;
+		case ACT_OPEN:
+			door_sensor_set(s, DOOR_RAW_OPEN);
+			break;
+		case ACT_DETACH:
+			door_sensor_set(s, DOOR_RAW_DETACHED);
+			break;
+		default:
+			return ScriptLS_Unhandled;
+	}
+	return ScriptLS_Finished;
+}
+
+static void door_sensor_realize(DeviceState *dev, Error **errp)
+{
+	DoorSensorState *s = DOOR_SENSOR(dev);
+	door_sensor_set(s, s->start_detached ? DOOR_RAW_DETACHED : DOOR_RAW_CLOSED);
+}
+
+static void door_sensor_init(Object *obj)
+{
+	DoorSensorState *s = DOOR_SENSOR(obj);
+	qdev_init_gpio_out(DEVICE(obj), &s->irq, 1);
+
+	script_handle pScript = script_instance_new(P404_SCRIPTABLE(obj), TYPE_DOOR_SENSOR);
+
+	script_register_action(pScript, "Close", "Reports the door as closed", ACT_CLOSE);
+	script_register_action(pScript, "Open", "Reports the door as open", ACT_OPEN);
+	script_register_action(pScript, "Detach", "Reports the door sensor as missing", ACT_DETACH);
+
+	scripthost_register_scriptable(pScript);
+}
+
+static const VMStateDescription vmstate_door_sensor = {
+	.name = TYPE_DOOR_SENSOR,
+	.version_id = 1,
+	.minimum_version_id = 1,
+	.fields = (VMStateField []) {
+		VMSTATE_UINT32(raw_value, DoorSensorState),
+		VMSTATE_END_OF_LIST(),
+	}
+};
+
+static const Property door_sensor_properties[] = {
+	DEFINE_PROP_BOOL("start-detached", DoorSensorState, start_detached, false),
+};
+
+static void door_sensor_class_init(ObjectClass *oc, const void *data)
+{
+	DeviceClass *dc = DEVICE_CLASS(oc);
+	device_class_set_legacy_reset(dc, door_sensor_reset);
+	dc->realize = door_sensor_realize;
+	dc->vmsd = &vmstate_door_sensor;
+
+	device_class_set_props(dc, door_sensor_properties);
+	P404ScriptIFClass *sc = P404_SCRIPTABLE_CLASS(oc);
+	sc->ScriptHandler = door_sensor_process_action;
+}
