new file mode 100644
index 0000000000..6ac43aafa6
--- /dev/null
+++ b/hw/arm/prusa/parts/tca6408a.c
@@ -0,0 +1,132 @@
+/*
+	tca6408a.c - TCA6408A I2C GPIO expander stub for Mini404
+
+    Written for Mini404 in 2026 in the style of FUSB302B.c by VintagePC.
+
+ 	This file is part of Mini404.
+	Mini404 is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 3 of the License, or
+	(at your option) any later version.
+	Mini404 is distributed in the hope that it will be useful,
+	but WITHOUT ANY WARRANTY; without even the implied warranty of
+	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+	GNU General Public License for more details.
+	You should have received a copy of the GNU General Public License
+	along with Mini404.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "hw/i2c/i2c.h"
+#include "hw/core/qdev-properties.h"
+#include "qom/object.h"
+
+
+#define TYPE_TCA6408A "tca6408a"
+
+// Register file: 0 input, 1 output, 2 polarity inversion, 3 configuration.
+#define TCA6408A_REG_INPUT 0U
+#define TCA6408A_REG_OUTPUT 1U
+#define TCA6408A_REG_POLARITY 2U
+#define TCA6408A_REG_CONFIG 3U
+#define TCA6408A_NUM_REGS 4U
+
+typedef struct TCA6408AState {
+    I2CSlave parent_obj;
+
+	uint8_t regs[TCA6408A_NUM_REGS];
+	uint8_t ptr;
+	bool have_ptr;
+
+} TCA6408AState;
+
+DECLARE_INSTANCE_CHECKER(TCA6408AState, TCA6408A,
+                         TYPE_TCA6408A)
+
+static
+int tca6408a_event(I2CSlave *ss, enum i2c_event event)
+{
+    TCA6408AState *s = TCA6408A(ss);
+	if (event == I2C_START_SEND)
+	{
+		s->have_ptr = false;
+	}
+	return 0;
+}
+
+static
+uint8_t tca6408a_recv(I2CSlave *ss)
+{
+    TCA6408AState *s = TCA6408A(ss);
+	uint8_t reg = s->ptr % TCA6408A_NUM_REGS;
+	uint8_t ret = s->regs[reg];
+	if (reg == TCA6408A_REG_INPUT)
+	{
+		// A pin configured as output reads back what was driven; an input
+		// floats high, as it would with the datasheet's pull-ups.
+		ret = (s->regs[TCA6408A_REG_OUTPUT] & ~s->regs[TCA6408A_REG_CONFIG]) | s->regs[TCA6408A_REG_CONFIG];
+	}
+    return ret;
+}
+
+static
+int tca6408a_send(I2CSlave *ss, uint8_t data)
+{
+    TCA6408AState *s = TCA6408A(ss);
+	if (!s->have_ptr)
+	{
+		s->ptr = data % TCA6408A_NUM_REGS;
+		s->have_ptr = true;
+	}
+	else if (s->ptr != TCA6408A_REG_INPUT) // the input register is read-only
+	{
+		s->regs[s->ptr] = data;
+	}
+    return 0;
+}
+
+static
+void tca6408a_reset(DeviceState *state)
+{
+    TCA6408AState *s = TCA6408A(I2C_SLAVE(state));
+	// Power-on defaults from the datasheet: outputs high, no polarity
+	// inversion, every pin an input.
+	s->regs[TCA6408A_REG_INPUT] = 0xFFU;
+	s->regs[TCA6408A_REG_OUTPUT] = 0xFFU;
+	s->regs[TCA6408A_REG_POLARITY] = 0U;
+	s->regs[TCA6408A_REG_CONFIG] = 0xFFU;
+	s->ptr = 0;
+	s->have_ptr = false;
+}
+
+static
+void tca6408a_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    k->event = &tca6408a_event;
+    k->recv = &tca6408a_recv;
+    k->send = &tca6408a_send;
+
+    device_class_set_legacy_reset(dc, tca6408a_reset);
+}
+
+static
+const TypeInfo tca6408a_type = {
+    .name = TYPE_TCA6408A,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(TCA6408AState),
+    .class_size = sizeof(I2CSlaveClass),
+    .class_init = tca6408a_class_init,
+};
+
+static void tca6408a_register(void)
+{
+    type_register_static(&tca6408a_type);
+}
+
+type_init(tca6408a_register)
