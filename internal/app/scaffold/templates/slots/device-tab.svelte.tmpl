<script lang="ts">
  import { heldHost } from './host';

  interface Props {
    /** The device this tab is about. It is the only prop a tab receives. */
    deviceId: string;
  }

  let { deviceId }: Props = $props();

  // The fleet is already on the host: the app reads it once and keeps it
  // current from the event stream, and a module receives it read-only. So this
  // tab makes no request of its own, and it redraws when an event moves this
  // device's row.
  const host = heldHost();
  const fleet = host.fleet;
  const t = host.t;

  const device = $derived(fleet.device(deviceId));
</script>

<div class="flex flex-col gap-4">
  {#if device === undefined}
    <p class="text-sm text-muted-foreground">
      {t('{{$.Name}}.deviceTab.absent')}
    </p>
  {:else}
    <p class="text-sm text-muted-foreground">
      {t('{{$.Name}}.deviceTab.body')}
    </p>
  {/if}
</div>
