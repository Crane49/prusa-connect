<script lang="ts">
  import { Badge } from '@prusa/connect-ui/primitives';

  import { heldHost } from './host';

  interface Props {
    /** The device this control is about. It is the only prop it receives. */
    deviceId: string;
  }

  let { deviceId }: Props = $props();

  // The fleet is already on the host: the app reads it once and keeps it
  // current from the event stream, and a module receives it read-only.
  const host = heldHost();
  const fleet = host.fleet;
  const t = host.t;

  const device = $derived(fleet.device(deviceId));
</script>

<!-- The host draws no frame and no heading here: this component is the whole
     box, under the printer's header and above its tabs. Draw nothing when
     there is nothing to say, and the page keeps no gap for it. -->
{#if device !== undefined}
  <div>
    <Badge variant="secondary">{t('{{$.Name}}.deviceHeader.body')}</Badge>
  </div>
{/if}
