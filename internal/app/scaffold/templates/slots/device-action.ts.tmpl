import { heldHost } from './host';

// The host calls this with the printer's id when a person picks the menu
// item. Throw or reject to show the person why it did not run; the host
// shows nothing on success, so report the result yourself.
// eslint-disable-next-line @typescript-eslint/require-await
export default async (deviceId: string): Promise<void> => {
  const host = heldHost();
  const device = host.fleet.device(deviceId);
  if (device === undefined) {
    throw new Error(host.t('{{$.Name}}.deviceAction.absent'));
  }
};
