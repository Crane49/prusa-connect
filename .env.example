# Copy to .env and adjust. Compose reads this file automatically.
#
# This configures the CONTAINER, not the server. The server itself is
# configured through config/config.yaml.

# ─── Host ports ──────────────────────────────────────────────────────────────
# Published by docker-compose.local.yml only. The base composition
# (docker-compose.yml) publishes nothing.

# Browser, REST/SSE API, and the printers. The container runs the core, which
# binds one listener at core.api.addr and serves the printer wires on it too.
# A deployment that gives printers a socket of their own sets listener.addr
# under the connector that serves them, in config/config.yaml, and publishes
# that port in docker/server/server.local.yml beside this one.
PCL_API_PORT=8080

# The Postgres fixture the dual-engine tests reach from the host.
PGFIXTURE_PORT=55432

# The developer Postgres `make postgres-dev-up` starts, with a database for the
# core and one for a module.
PGDEV_PORT=55433

# The OpenID Connect issuer the login flow runs against. The container publishes
# an issuer identifier built from the Host header it is reached on, so moving
# this port means moving PCL_OIDC_ISSUER below with it.
#
# High, like the fixture ports below, because the issuer's own port 8092 is a
# common one: another stack publishing an issuer there is what the login suite
# reaches instead, and it authenticates a different set of subjects.
PCL_OIDC_PORT=58092

# ─── Image ───────────────────────────────────────────────────────────────────

# Tag the compose stack builds and runs.
PRUSA_CONNECT_TAG=local

# The version the image's binary reports in its log, at /api/v1/health and for
# --version. The image build cannot read .git, so it is passed in. Empty
# stamps nothing. A build from a release archive sets the release, 0.2.0.
PCL_BUILD_VERSION=

# ─── Test fixtures ───────────────────────────────────────────────────────────
# Brought up by docker-compose.local.yml and used by `make test-engines`. The
# fixture is discarded after every run and holds nothing worth keeping, so
# these are not secrets and the defaults are fine to commit.

PGFIXTURE_USER=authz
PGFIXTURE_PASSWORD=authz
PGFIXTURE_DB=authz

# The developer Postgres. The passwords are read on the first start of an empty
# volume only. They are development values and fine to commit.
PGDEV_ADMIN_USER=postgres
PGDEV_ADMIN_PASSWORD=postgres
PGDEV_CORE_PASSWORD=connect
PGDEV_MODULE_PASSWORD=notes

# The issuer internal/platform/auth/oidc discovers, and the redirect the browser
# comes back to. They are development values: the issuer authenticates whoever
# picks a name off its login page, which is why it is in the local composition
# only.
#
# The login tests skip themselves when the issuer is unreachable, so a clone
# with no Docker still runs the suite. They never take a shortcut past a check.
PCL_OIDC_ISSUER=http://localhost:58092
PCL_OIDC_CLIENT_ID=prusa-connect
PCL_OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback

# ─── Test fixture ports ──────────────────────────────────────────────────────
# The brokers the event sink adapters are verified against, in the local stack.
# High ports so a broker a developer already runs on the default one is not
# shadowed, and so two developers can differ without editing tracked yaml.
#
#   docker compose -f docker-compose.local.yml up -d
#
MQTT_FIXTURE_PORT=51883
AMQP_FIXTURE_PORT=55672
KAFKA_FIXTURE_PORT=59092

# The npm registry `make client-sdk-install-check` publishes the client SDK to
# and installs it back from. 4873 is Verdaccio's own port, so the default is
# high for the same reason the broker ports are.
NPM_FIXTURE_PORT=54873

# ─── The race detector on Linux ──────────────────────────────────────────────
# `make test-race-linux` runs go test under -race in a container built from
# this tree, against the Postgres fixture. PACKAGES and TAGS are passed on the
# make command line, not set here.
#
# The memory ceiling of that container. 16G is what a GitHub-hosted runner has.
# A Docker Desktop VM with less than that has to hold the run under its own
# size, or the compile of a large dependency under the detector fails with
# `cannot allocate memory`.
RACE_MEMORY_LIMIT=16G

# ─── Documentation site ──────────────────────────────────────────────────────
# `make docs-up` serves the built site from a container at
# http://127.0.0.1:${DOCS_PORT}/docs/. High, because 4322 is the port the
# docs dev server takes.
DOCS_PORT=54322
