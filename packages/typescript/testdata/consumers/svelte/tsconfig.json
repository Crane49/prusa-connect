{
  // skipLibCheck is off on purpose: the shipped .d.ts files are checked under
  // a browser lib set, through svelte-check, which is what a Svelte project
  // runs.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
