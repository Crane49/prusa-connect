{
  "name": "buddy3d-camera-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The browser half of the Buddy3D camera module: the camera section on a printer's page and the Buddy3D cameras settings tab.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run check:svelte && pnpm run test"
  },
  "dependencies": {
    "@prusa/connect": "0.1.0",
    "@prusa/connect-ui": "0.1.0",
    "buddy3d-camera-client": "link:../client"
  },
  "devDependencies": {
    "@prusa/frontend-standards": "0.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
